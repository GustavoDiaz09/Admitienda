# Configuración de Supabase (solo se usa para sincronización; la app funciona 100 % local).
# Copie este archivo a `.env` y complete los valores de su proyecto Supabase.
# ADVERTENCIA: el `.env` real NO se sube al repositorio (está en .gitignore).

# URL de su proyecto, p. ej. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave anon (publicable) del proyecto, p. ej. eyJhbGciOi...
VITE_SUPABASE_ANON_KEY=